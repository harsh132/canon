{
  "name": "pangolin",
  "private": true,
  "version": "0.0.0",
  "description": "Pangolin: a privacy wallet. Monorepo.",
  "workspaces": ["apps/*", "packages/*"],
  "packageManager": "bun@1.4.4",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck"
  }
}
