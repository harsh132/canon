{
  "manifest_version": 3,
  "name": "Canon Wallet",
  "short_name": "Canon Wallet",
  "version": "0.1.0",
  "version_name": "0.1.0-alpha",
  "description": "A private Ethereum wallet on RAILGUN.",
  "minimum_chrome_version": "120",
  "key": "",
  "action": {
    "default_title": "Canon Wallet"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "offscreen",
    "sidePanel",
    "favicon"
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'",
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; child-src 'self' blob:; worker-src 'self' blob:; connect-src *;"
  },
  "sandbox": {
    "pages": [
      "anon-rpc/*/sandbox.html"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "inpage.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "side_panel": {
    "default_path": "panel.html"
  }
}
