# WalletConnect project id (free at cloud.reown.com). Public config, embedded in the build.
CANON_WC_PROJECT_ID=
# Sepolia RPC. Defaults to PublicNode.
CANON_SEPOLIA_RPC=
# Sponsor for name claims and gasless calls. Defaults to the hosted canon-sponsor
# (a local one, http://127.0.0.1:8792, for CANON_FORK builds).
CANON_SPONSOR_URL=
